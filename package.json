{
  "name": "cloakyard",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp build",
    "deploy": "vp check && vp build && wrangler deploy",
    "generate:og": "node scripts/render-og.mjs",
    "design:light": "node scripts/build-air-light.mjs",
    "design:light:check": "node scripts/build-air-light.mjs --check",
    "design:overlays": "node scripts/build-air-overlays.mjs",
    "design:overlays:check": "node scripts/build-air-overlays.mjs --check",
    "design:check": "node scripts/check-air-design.mjs",
    "design:portability": "node scripts/check-air-portability.mjs",
    "design:inventory": "node scripts/air-inventory.mjs",
    "design:sync": "node scripts/sync-air-design.mjs",
    "design:files:test": "node --test scripts/test-air-file-workflow.mjs",
    "test:air-links": "node scripts/test-air-links.mjs"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@base-ui/react": "1.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "shaders": "4.0.5",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "4.152.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0"
}
